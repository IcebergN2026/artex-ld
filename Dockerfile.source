# syntax=docker/dockerfile:1
# 本地源码一体化构建：docker compose 使用此文件。
# 根目录 Dockerfile 仍用于 CI 预编译二进制打包，二者不要混用。

FROM node:22-bookworm AS web-builder
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/norma ./third_party/norma
RUN go mod download
COPY . .
COPY --from=web-builder /src/web/out ./server/webui/dist
RUN CGO_ENABLED=0 go build -tags embedui -trimpath -o /out/artex ./cmd/artex

# 运行层与根目录 Dockerfile 保持一致，仅把预编译 COPY 改为 builder 产物。
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 预装 Playwright MCP / CLI 与 Chromium，运行时不需首次联网下载。
RUN npm install -g @playwright/mcp@latest @playwright/cli@latest playwright@latest \
    && playwright-cli --help \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=go-builder /out/artex /app/artex
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/

# JWT 签名密钥落到持久化数据卷，容器重建后旧登录 token 仍有效。
RUN ln -sf /app/data/jwt.key /app/jwt.key

VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
