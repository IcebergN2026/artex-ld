# Docker 部署配置（复制为 .env）
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=artex
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 日志：级别开关（P-LOG·M0）。ARTEX_LOG_LEVEL=debug/info/warn/error（默认 info）。
# debug 级日志（worker 工具调用细节等约 20 个点）正常模式零输出零落库。
# ARTEX_DEBUG=1 等价于 ARTEX_LOG_LEVEL=debug（H1 旧开关，保留兼容）。
# 优先级：UI /system/settings 热切换（settings 表 log_level，立即生效）> ARTEX_LOG_LEVEL > ARTEX_DEBUG > info。
ARTEX_LOG_LEVEL=
ARTEX_DEBUG=
