# Docker 部署生成的本地环境（含密码/密钥，不提交）
.env

# 调度器运行/模拟产生的事件日志（测试产物，不提交）
*-events.csv

# bench 基准测试相关（本地产物，不提交）
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2

# 构建/评审产物与恢复暂存
/_release/
/.validation-logs/
/.recovered/
/.next/

# 开发过程文档（本地保留，不同步）
/dev/

# 运行时备份（含密钥/业务数据，本地保留，不提交）
/backup/

# 配置导出快照（export-config 产物，含密钥明文；配置种子已在源码内置，无需入库）
/config-export/