# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo


# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# 内嵌前端的单二进制产物（build.sh 命名：artex-<版本>-<os>-<arch> / artex-<os>-<arch>/）
/artex
/artex-*
# 一键更新在可执行文件旁留下的中间产物（暂存件 / 备份 / 失败版本 / 升级标记）
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT 签名密钥（运行时生成，存项目根，绝不提交）
/jwt.key

# 环境变量文件（.env / .env.production / .envrc 等含密码与密钥，不提交；仅保留模板）
.env*
!.env.example

# 调度器运行/模拟产生的事件日志（测试产物，不提交）
*-events.csv

# bench 基准测试相关（本地产物，不提交）
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2

# 构建/评审产物与恢复暂存
/_release/
/.validation-logs/
/.recovered/
/.next/

# 开发过程文档（本地保留，不同步）
/dev/

# 运行时备份（含密钥/业务数据，本地保留，不提交）
/backup/

# 配置导出快照（export-config 产物，含密钥明文；配置种子已在源码内置，无需入库）
/config-export/
# 本地工具/编辑器状态（.omp 含内网主机与 SSH 私钥路径，绝不提交）
/.omp/
/.obsidian/

# 密钥与证书（与 .dockerignore 对齐；运行时 jwt.key 见上）
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk

# 数据库转储（业务数据，不提交；db/schema.sql 仍入库）
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# 本地部署产物（start.sh 示例 ./start.sh >artex.log；install.sh 在同目录取 artex*.tar.gz）
*.tar.gz
*.log
nohup.out

# 本地临时文件与备份清单
*.tmp
/*_agent.list
*.bak

# 测试/性能产物与补丁残留
*.test
*.prof
coverage.out
*.orig
*.rej
*~
